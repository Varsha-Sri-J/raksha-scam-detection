# Server Configuration
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated if parsed, or array in config)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# WebSocket Settings
WS_HEARTBEAT_INTERVAL_SECONDS=30

# Baseline Risk Engine
BASELINE_RISK_SCORE=0.0

# Speech-to-Text (STT) Settings
STT_PROVIDER=mock
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en
DEEPGRAM_SAMPLE_RATE=8000
DEEPGRAM_ENCODING=mulaw

# Twilio Configuration (Phase 5A)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_STREAM_BASE_URL=
TWILIO_VALIDATE_SIGNATURE=False
TWILIO_API_TIMEOUT_SECONDS=3.0

# Intervention Provider (Phase 7D-2)
INTERVENTION_PROVIDER=mock

# User Warning Provider (Phase 7D-3)
USER_WARNING_PROVIDER=mock
PROTECTED_USER_PHONE_NUMBER=
